# Copy to .env for local development (npm run dev reads it). Never commit .env.
# Comma-separated sensorId:token pairs. Tokens must be at least 16 characters;
# generate one with: openssl rand -hex 24
DEVICE_TOKENS=seat-001:replace-with-a-long-random-token
PORT=3001
# Append-only event log (JSON Lines). Leave empty to keep events in memory only.
EVENTS_FILE=./data/events.jsonl
# OFFLINE_AFTER_MS=30000
# MAX_EVENTS=500
# MAX_STREAM_CLIENTS=100
# SSE_KEEPALIVE_MS=15000
